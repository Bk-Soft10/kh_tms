<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_hangersation" model="ir.ui.view">
        <field name="name">account.move.form.inherit.hangersation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <group string="Hangersation Details">
                    <field name="show_hangersation_fields" />
                    <field name="hangersation_quantity" invisible="not show_hangersation_fields" string="Hangersation Quantity"/>
                    <field name="hangersation_price" invisible="not show_hangersation_fields" string="Hangersation Price"/>
                    <field name="delivery_date_from" invisible="not show_hangersation_fields" />
                    <field name="delivery_date_to" invisible="not show_hangersation_fields" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
