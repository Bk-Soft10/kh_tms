<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hr_document_report_template">
      <t t-call="web.html_container">
          <t t-call="web.external_layout">
              <style>
                  body, table, td, strong, h2 ,th, p, div, span {
                  font-family: 'Segoe UI', sans-serif;
                  }
              </style>
              <div class="page">
            <h2>Employee Document Report</h2>
            <p>Date Range: <span t-esc="date_from"/> to <span t-esc="date_to"/></p>
            <p>Employee: <span t-esc="employee_id"/></p>

            <!-- Debug information
            <p>Debug: Number of docs: <t t-esc="len(employee_documents) if docs else 'N/A'"/></p>
            <p>Debug: doc_ids: <t t-esc="employee_documents"/></p>
            -->
            <t t-if="employee_documents">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Employee name</th>
                            <th>Document name</th>
                            <th>Document Type</th>
                            <th>Expiry Date</th>
                        </tr>
                    </thead>
                    <tbody>

                        <t t-foreach="employee_documents" t-as="d">
                            <tr>
                                <td><t t-esc="d.get('Emp_name').strip()"/></td>
                                 <td><t t-esc="d.get('doc_name').strip()"/></td>
                                 <td><t t-esc="d.get('doc_type', '')" /></td>
                                 <td><t t-esc="d.get('expiry_date', '')" /></td>

                            </tr>

                        </t>

                    </tbody>
                </table>
            </t>

            <t t-else="">
                <p>No documents found for the selected criteria.</p>
            </t>

        </div>
          </t>
      </t>
     </template>
</odoo>
