<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_res_config_settings_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.excel_template</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                 <div class="app_settings_block" data-string="Custom Excel" string="Custom Excel" data-key="custom_excel_config">
                    <h2>Bank Excel Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Upload Excel Sheet</span>
                                <div class="text-muted">
                                    Upload an Excel sheet for configuration
                                </div>
                                <div class="content-group">
                                    <field name="excel_sheet" filename="excel_filename"/>
                                    <field name="excel_filename" invisible="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>
</odoo>
