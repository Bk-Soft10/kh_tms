        <t t-set="receiptsc" t-value="state.data.receiptsc"/>
        <t t-set="receiptsi" t-value="state.data.receiptsi"/>
        <t t-set="receiptstoc" t-value="state.data.receiptstoc"/>
        <t t-set="receiptstoi" t-value="state.data.receiptstoi"/>
        <t t-set="trips" t-value="state.data.trips"/>
        <t t-set="rkys" t-value="state.data.rkys"/>
        <t t-set="create_receipt" t-value="state.data.create_receipt"/>
        <t t-set="create_itans" t-value="state.data.create_itans"/>
        <t t-set="create_trip" t-value="state.data.create_trip"/>
        <t t-set="draft" t-value="state.data.draft"/>-->
        <div classs="tms_dashboard-wrapper" id="tms_dashboard">
            <t t-value="draft['drafti']" t-set="drafti"/>
            <t t-value="draft['draftc']" t-set="draftc"/>
            <div class="dash-row">
                <div class="dash-heading">
                <h3>Personal Receipts</h3>
                    <div class="o_list_buttons">
                    <input type="text" id="sash-search-box" placeholder="ابحث عن سند او رحلة"/>
