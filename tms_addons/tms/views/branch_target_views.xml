<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tms_branch_target_form" model="ir.ui.view">
        <field name="name">tms.branch.target</field>
        <field name="model">tms.branch.target</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="TMS Branch Target">
                
                <header>
                    <button name="action_post" string="Post" type="object" class="oe_highlight" states="d"/>
                    <button name="action_create_target_lines" string="Create Targets" type="object" class="oe_highlight" states="d"/>
                    <field name="state" widget="statusbar"/>
                </header>
                
                <sheet string="Branch Target">
                   <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="month"/>
                            <field name="year"/>
                            <field name="target"/>
                        </group>
                    </group>
                    <field colspan="4" mode="tree" name="line_ids">
                        <tree editable="top" string="Details">
                            <field name="branch_id"/>
                            <field name="target"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_tms_branch_target_tree" model="ir.ui.view">
        <field name="name">tms.branch.target.tree</field>
        <field name="model">tms.branch.target</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="TMS Car Brand">
                <field name="name"/>
                <field name="target"/>
            </tree>
        </field>
    </record>
    <record id="action_tms_branch_target" model="ir.actions.act_window">
        <field name="name">Branch Target</field>
        <field name="res_model">tms.branch.target</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_tms_branch_target_tree"/>
    </record>
        <menuitem id="menu_tms_branch_target" action="action_tms_branch_target" parent="menu_tms_config" sequence="4"/>     

</odoo>
