<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_tms_jr_branch_receipt" model="ir.ui.view">
            <field name="name">Branch Receipt Report</field>
            <field name="model">tms.jr.branch.receipt</field>
            <field name="arch" type="xml">
                <form>
                    <group class="nomrh">
                        <group><field name="branch_id" options="{'no_create': true, 'no_open': true}"/></group>
                        <group><field name="branch_to_id" options="{'no_create': true, 'no_open': true}"/></group>
                    </group>
                    <group class="nomrh">
                        <group><field name="date_from"/></group>
                        <group><field name="date_to"/></group>
                    </group>
                    <footer>
                        <button name="action_show_report" string="Print" type="object" default_focus="1" class="oe_highlight"/> 
                        <button string="Cancel" data-dismiss="modal" class="btn-default" special="cancel"/>   
                    </footer>
               </form>
            </field>
        </record>
        
        <record id="view_tms_jr_branch_receipt_sub" model="ir.ui.view">
            <field name="name">Branch Receipt Report Sub</field>
            <field name="model">tms.jr.branch.receipt</field>
            <field name="inherit_id" ref="view_tms_jr_branch_receipt"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//footer" position="before">
                         <group class="nomrh">
                            <group><field name="ptype" string="Client Type" widget="radio" options="{'horizontal': true}"/></group>
                        </group>
                    </xpath>
                </data>
            </field>
        </record>
        

        <record id="action_tms_jr_branch_receipt" model="ir.actions.act_window">
            <field name="name">Branch Receipt Report</field>
            <field name="res_model">tms.jr.branch.receipt</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_tms_jr_branch_receipt_sub"/>
            <field name="target">new</field>
            <field name="binding_type">report</field>
        </record>
        
        
        <record id="view_tms_jr_user_branch_payment" model="ir.ui.view">
