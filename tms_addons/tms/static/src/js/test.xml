                            <a href="#" type="button" action="open_receipts_c" state="d">
                                <i class="fa fa-exclamation-triangle" style="color: #fffa2b;font-size: 18px;"/>
                                <t t-esc="draftc"/> &amp;nbsp; Drafts
                            </a>
                        </t>-->
                        <t t-if="create_trip">
                        <a href="#" type="button" action="create_trip" state="n">
