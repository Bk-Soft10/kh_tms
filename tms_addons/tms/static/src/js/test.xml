                </div>
            </div>
                <t t-if="rkys" t-foreach="rkys" t-as="dash" t-key="dash">
                <t t-value="receiptsi[dash]" t-set="item"/>
                    <t t-value="receiptstoi[dash]" t-set="item2"/>
                    <div class="dash-item">
                  <div class="panel widget mb0 b0">
                      <div class="row-table row-flush">
                          <div t-att-class="'w1x text-center dash-icon bg-'+ item[3]">
                              <em t-att-class="'fa-2x fa fa-'+ item[4] "/>
                          </div>
                          <div class="w2x">
                              <div class="text-center">
                                  <t t-if="dash=='t'">
                                    <a href="#" class="hx d-link" action="open_receipts_i" style="width:100%"
                                       t-att-state="item[1]" to="1">
                                          <span class="spnex">Incomming</span>
                                        <i class="fa fa-arrow-down"/>
                                        <h4 class="mb-sm"><t t-esc="item[0]"/></h4>
                                    </a>
                                  </t>
                                  <t t-if="dash!='t'">
                                      <a href="#" class="hx d-link bord-right" action="open_receipts_i"
                                         t-att-state="item[1]">
                                          <i class="fa fa-arrow-up" style="margin-right: 2px;"/>
                                          <span class="spnex">Outgoing</span>
                                          <h4 class="mb-sm"><t t-esc="item[0]"/></h4>
                                      </a>
                                      <a href="#" class="hx d-link" action="open_receipts_i" t-att-state="item2[1]"
                                         to="1">
                                          <span class="spnex">Incomming</span>
                                          <i class="fa fa-arrow-down"/>
                                          <h4 class="mb-sm"><t t-esc="item2[0]"/></h4>
                                      </a>
                                  </t>
                                  <strong class="text-muted"><t t-esc="item[2]"/></strong>
                              </div>
                          </div>
                      </div>
                  </div>
                </div>
            </t>
            </div>
            <div class="dash-row">
                <div class="dash-heading">

                <h3>Company Receipts</h3>
                    <div class="o_list_buttons">
