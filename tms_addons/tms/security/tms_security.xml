<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record  id="module_category_tms" model="ir.module.category">
            <field name="name">TMS</field>
            <field name="description">User access level for this module</field>
            <field name="sequence">3</field>
        </record>
        
        <record id="group_tms_stop_trip" model="res.groups">
            <field name="name">Stop Trip</field>
            <field name="comment">The user can stop trip.</field>
        </record>
    
        <record id="group_tms_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_tms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_tms_acontant" model="res.groups">
            <field name="name">Acontant</field>
            <field name="comment">the user will have an access to the tms acountant.</field>
            <field name="category_id" ref="module_category_tms"/>
            <field name="implied_ids" eval="[(4, ref('group_tms_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>
        
        <record id="group_tms_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="comment">the user will have an access to the tms resources.</field>
            <field name="category_id" ref="module_category_tms"/>
            <field name="implied_ids" eval="[(4, ref('group_tms_acontant')),(4, ref('group_tms_stop_trip'))]"/>
        </record>
        
        <record id="group_tms_cancel_payment" model="res.groups">
            <field name="name">Cancel Receipt Payment</field>
            <field name="comment">the user can cancel receipt payment.</field>
        </record>
        
        <record id="group_tms_cancel_trip_takeoff" model="res.groups">
            <field name="name">Cancel Trip Takeoff</field>
            <field name="comment">the user can cancel tak.</field>
        </record>
        
        <record id="group_tms_trip_takeoff" model="res.groups">
            <field name="name">Trip Takeoff</field>
            <field name="comment">User can takoff Trip.</field>
        </record>
        
        <record id="group_tms_cancel_itrans" model="res.groups">
            <field name="name">Cancel Internal Transport</field>
        </record>
        
        <record id="group_tms_cancel_receipt" model="res.groups">
            <field name="name">Cancel Receipt</field>
        </record>
        
        <record id="group_tms_show_activity" model="res.groups">
            <field name="name">Show Activity</field>
        </record>
        
        <record id="group_tms_receipt_date" model="res.groups">
            <field name="name">Change Receipts Date</field>
        </record>
        
        <record id="group_tms_payment_date" model="res.groups">
            <field name="name">Change Payment Date</field>
        </record>
        
        <record id="group_tms_post_receipt" model="res.groups">
            <field name="name">Post Receipts</field>
        </record>
        
        <record id="group_tms_remove_route" model="res.groups">
            <field name="name">Remove Route</field>
        </record>
        
        <record id="group_tms_extra_receipt_price" model="res.groups">
            <field name="name">Extra Receipt Price</field>
        </record>
        
        <record id="group_tms_price_manager" model="res.groups">
            <field name="name">City and Partners Prices</field>
        </record>
        
        <record id="group_tms_analaytic" model="res.groups">
            <field name="name">Transport Analaytic</field>
        </record>
        
        <record id="group_tms_root_user" model="res.groups">
            <field name="name">TMS Root User Previllage</field>
        </record>
        <record id="group_tms_company_accountant" model="res.groups">
            <field name="name">Companies Accountant</field>
        </record>
        
        <record id="group_tms_change_receipt_price" model="res.groups">
            <field name="name">Change Receipt Price</field>
        </record>
        
        <record id="group_tms_edit_payment" model="res.groups">
            <field name="name">Edit Payment</field>
        </record>
        
        
        <record id="group_tms_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="comment">the user will have an access to the tms resources and configuration.</field>
            <field name="category_id" ref="module_category_tms"/>
            <field name="implied_ids" eval="[(4, ref('group_tms_manager')),
                (4, ref('group_tms_cancel_payment')),(4, ref('group_tms_cancel_trip_takeoff')),
                (4, ref('group_tms_price_manager')), (4, ref('group_tms_remove_route')),
                (4, ref('group_tms_analaytic')), (4, ref('group_tms_edit_payment'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        
    </data>
    
    <data noupdate="1">
        <record id="group_tms_edit_pickup_price" model="res.groups">
            <field name="name">Edit Pickup Price</field>
        </record>
    </data>

</odoo>