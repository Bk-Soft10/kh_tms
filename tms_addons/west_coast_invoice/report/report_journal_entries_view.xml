<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_wc">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-set="paid_amount" t-value="o.amount_total - o.amount_residual"/>
                    <div class="page">
                        <div class="header">
                            <div class="row">
                                <div class="col-6">
                                    <h2 style="font-weight:bold;">فاتورة ضريبية</h2>
                                    <img t-if="o.l10n_sa_qr_code_str"
                                         style="display:block;"
                                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(o.l10n_sa_qr_code_str), 100, 100)"/>
                                </div>
                                <div class="col-6 text-right">
                                    <span style="font-weight:bold;" t-field="o.company_id.name"/>
                                    <t t-if="o.company_id.street">
                                        <br/>
                                        <span t-field="o.company_id.street"/>
                                    </t>
                                    <t t-if="o.company_id.street2">
                                        <br/>
                                        <span t-field="o.company_id.street2"/>
                                    </t>
                                    <t t-if="o.company_id.city">
                                        <br/>
                                        <span t-field="o.company_id.city"/>
                                    </t>
                                    <t t-if="o.company_id.state_id.name">
                                        <br/>
                                        <span t-field="o.company_id.state_id.name"/>
                                    </t>
                                    <t t-if="o.company_id.zip">
                                        <br/>
                                        <span t-field="o.company_id.zip"/>
                                    </t>
                                    <t t-if="o.company_id.country_id.name">
                                        <br/>
                                        <span t-field="o.company_id.country_id.name"/>
                                    </t>
                                    <t t-if="o.company_id.vat">
                                        <br/>
                                        الرقم اﻟﻀﺮﻳﺒﻲ:
                                        <span t-field="o.company_id.vat"/>
                                    </t>
                                </div>

                            </div>
                        </div>
                        <hr style="border:none;height: 3px;color: #a57c73;background-color: #a57c73;"></hr>
                        <div class="body">
                            <div class="row">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="text-align: right;vertical-align: top;">
                                            <span t-field="o.name"/>
                                        </td>
                                        <td rowspan="4" style="text-align: right;font-weight:bold;vertical-align: top;" class="text-right arabic">رقم
                                            الفاتورة
                                        </td>
                                        <td rowspan="4" style="text-align: right;vertical-align: top;">
                                            <div>
                                                <span t-field="o.partner_id.name"/>
                                                <t t-if="o.partner_id.street">
                                                    <br/>
                                                    اﻟﻌﻨﻮان:
                                                    <span t-field="o.partner_id.street"/>
                                                </t>
                                                <t t-if="o.partner_id.street2">
                                                    <br/>
                                                    <span t-field="o.partner_id.street2"/>
                                                </t>
                                                <t t-if="o.partner_id.city">
                                                    <br/>
                                                    <span t-field="o.partner_id.city"/>
                                                </t>
                                                <t t-if="o.partner_id.state_id.name">
                                                    <br/>
                                                    <span t-field="o.partner_id.state_id.name"/>
                                                </t>
                                                <t t-if="o.partner_id.zip">
                                                    <br/>
                                                    <span t-field="o.partner_id.zip"/>
                                                </t>
                                                <t t-if="o.partner_id.country_id.name">
                                                    <br/>
                                                    <span t-field="o.partner_id.country_id.name"/>
                                                </t>
                                                <t t-if="o.partner_id.vat">
                                                    <br/>
                                                    الرقم اﻟﻀﺮﻳﺒﻲ:
                                                    <span t-field="o.partner_id.vat"/>
                                                </t>
                                            </div>
                                        </td>
                                        <td rowspan="4" style="text-align: right;font-weight:bold;width: 15%;vertical-align: top;"
                                            class="text-right arabic">فاتورة
                                            الي
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right;vertical-align: top;">
                                            <t t-if="o.invoice_date">
                                                تاريخ الفاتورة
                                                <span t-field="o.invoice_date"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right;vertical-align: top;">
                                            <t t-if="o.invoice_date_due">
                                                تاريخ الاستحقاق
                                                <span t-field="o.invoice_date_due"/>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                                <br/>
                            <div >

                                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                                <table style="width:100%; border: 1px solid black; border-collapse: collapse;" class="table table-sm o_main_table"
                                       name="invoice_line_table">
                                    <thead>
                                        <tr style="background-color: #f0f0f0;">
                                            <t t-set="colspan" t-value="6"/>
                                            <th style="width:20%;text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                name="th_total"
                                                class="text-right">
                                                <span>
                                                    الاجمالي
                                                </span>
                                            </th>
                                            <th style="width:15%;text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                name="th_priceunit" class="text-right">
                                                <span>
                                                    السعر
                                                </span>
                                            </th>
                                            <th style="width:15%;text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                name="th_quantity" class="text-right">
                                                <span>
                                                    الكمية
                                                </span>
                                            </th>
                                            <th style="width:50%;text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                name="th_description" class="text-left">
                                                <span>
                                                    الوصف
                                                </span>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody class="invoice_tbody">
                                        <t t-set="current_subtotal" t-value="0"/>
                                        <t t-set="lines"
                                           t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                        <t t-foreach="lines" t-as="line">
                                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                               groups="account.group_show_line_subtotals_tax_included"/>

                                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                                <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                                    <td style="text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                        class="text-right o_price_total">
                                                        <span class="text-nowrap" t-field="line.price_total"/>
                                                    </td>
                                                    <td style="text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                        class="text-right">
                                                        <span class="text-nowrap" t-field="line.price_unit"/>
                                                    </td>
                                                    <td style="text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                        class="text-right">
                                                        <span t-field="line.quantity"/>
                                                        <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                    </td>
                                                    <td style="text-align: right; vertical-align: top; border: 1px solid black; padding: 8px;"
                                                        name="account_invoice_line_name">
                                                        <t>
                                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                        </t>
                                                    </td>
                                                </t>
                                                <t t-if="line.display_type == 'line_section'">
                                                    <td colspan="99" style="border: 1px solid black; padding: 8px;">
                                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                    </td>
                                                    <t t-set="current_section" t-value="line"/>
                                                    <t t-set="current_subtotal" t-value="0"/>
                                                </t>
                                                <t t-if="line.display_type == 'line_note'">
                                                    <td colspan="99" style="border: 1px solid black; padding: 8px;">
                                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                    </td>
                                                </t>
                                            </tr>

                                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                                <tr class="is-subtotal text-right">
                                                    <td colspan="99" style="border: 1px solid black; padding: 8px;">
                                                        <strong class="mr16" style="display: inline-block">Subtotal/الإجمالي الفرعي</strong>
                                                        <span t-out="current_subtotal"
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                                <table style="width=100%;">
                                    <br/>
                                    <t>
                                        <tr>
                                            <td style="width:20%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                <span t-field="o.amount_tax"/>
                                            </td>
                                            <td style="width:30%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                القمية المضافة 15%
                                            </td>
                                            <td style="width:50%;" colspan="2">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:20%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                <span t-field="o.amount_untaxed"/>
                                            </td>
                                            <td style="width:30%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                اﻹﺟﻤﺎﻟﻲ شامل الضريبة القمية المضافة
                                            </td>
                                            <td style="width:50%;" colspan="2">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:20%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                <span t-esc="paid_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td style="width:30%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                اﻟﻤﺪﻓﻮع (اﻟﻤﺤﻔظة)
                                            </td>
                                            <td style="width:50%;" colspan="2">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:20%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                <span t-field="o.amount_residual"/>
                                            </td>
                                            <td style="width:30%;text-align: right; vertical-align: top; border-bottom: 1px solid black; padding: 4px;">
                                                اﻟﻤﺒﻠﻎ اﻟﻤﺴﺘﺤﻖ
                                            </td>
                                            <td style="width:50%;" colspan="2">
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                                <div style="text-align:right;">
                                    <p t-if="o.narration" name="comment">
                                        <div class="row">
                                            <div class="col-12 text-right">
                                                <span t-field="o.narration"/>
                                            </div>
                                        </div>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>


        <template id="journal_entry_report_template_id">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="west_coast_invoice.report_invoice_document_wc"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
