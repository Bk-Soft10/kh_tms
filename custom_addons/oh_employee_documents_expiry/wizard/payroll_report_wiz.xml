<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_payroll_report_view_form">
        <field name="name">payroll.report.wiz.form</field>
        <field name="model">documents.report.wiz</field>
        <field name="arch" type="xml">
            <form string="Payroll Report">
                <group colspan="4" col="4">
                    <field name="from_date"/>
                    <field name="date_end"/>
                    <field name="document_type_id"/>


                </group>
                <group>
                    <field name="filter" widget="radio"/>
                    <field name="employee_id"
                           invisible="filter != 'employee'"
                           required="filter == 'employee'"
                           force_save="1"
                    />
                </group>
                <footer>

                    <button name="action_generate_report" type="object" string="Export PDF" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>

                </footer>
            </form>
        </field>
    </record>

     <record id="action_payroll_reporting_excel" model="ir.actions.act_window">
        <field name="name">Document Report</field>
        <field name="res_model">documents.report.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="menu_document_report"
              name="Documents Report"
              action="action_payroll_reporting_excel"
              sequence="77"
              parent="oh_employee_documents_expiry.menu_human_resources_configuration_document"

    />
</odoo>
