                 <div class="page">


                     <div class="row mt32 mb32">
                      <div class="col-6">

            <div class="client-info">
                <p><strong>To:</strong> </p>
                <p><span t-esc="doc.partner_id.name" style="font-size: 40px;" /></p>

                <p><strong>P.</strong> <span t-esc="doc.partner_id.phone" /></p>
                <p><strong>W.</strong> <span t-esc="doc.partner_id.email" /></p>
                <p><strong>A.</strong> <span t-esc="doc.partner_id.street" />, <span t-esc="doc.partner_id.city" />, <span t-esc="doc.partner_id.zip" />, <span t-esc="doc.partner_id.country_id.name" /></p>
            </div>

                      </div>
                          <div class="col-6">
                                <!-- Invoice Details -->

                              <table style="width: 100%; direction: rtl; text-align: center;font-size: 13px;font-family: 'Segoe UI', sans-serif; border-collapse: separate;border-spacing: 10px;">
                <thead>
                    <tr>
                        <th class="th-border-black">طلب عرض الأسعار</th>
                        <th class="th-border-gray"> </th>

                    </tr>
                </thead>
                <tr>
                    <td class="invoice-date">تاريخ التأكيد</td>
                    <td class="invoice-date">رقم  طلب العرض </td>
                </tr>
                <tr>
                    <td class="invoice-date"><span t-esc="doc.date_approve" /></td>
                    <td class="invoice-date"> <span t-esc="doc.name" /></td>
                </tr>
                <tr>
                    <td class="invoice-date">تاريخ الإصدار</td>
                    <td class="invoice-date">المجموع المستحق</td>
                 </tr>
                <tr>
                    <td class="invoice-date"><span t-esc="doc.date_order" /></td>
                      <td class="invoice-date"> <span t-esc="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' /></td>
                </tr>
            </table>

                          </div>
                     </div>

                      <hr class="invoice-date"></hr>


            <!-- Invoice Table -->
            <table class="invoice-table">
                <thead>
                     <tr class="invoice-date">
                        <th> الكمية</th>
                         <th> التاريخ المتوقع</th>
                        <th>المنتج</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.order_line" t-as="line">
                        <tr class="invoice-date">
                            <td><span t-esc="line.product_uom_qty"  /></td>
                            <td><span t-esc="line.date_planned" /></td>
                            <td><span t-esc="line.product_id.display_name" /><br/><small t-esc="line.name" /></td>
                         </tr>
                    </t>
                </tbody>

            </table>

