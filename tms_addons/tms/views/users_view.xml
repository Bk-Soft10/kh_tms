<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_users_branch_form" model="ir.ui.view">
            <field name="name">res.users.branch.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <div class="oe_title" position="inside">
                    <group>
                        <field name="emp_code" placeholder="Employee Code"/>
                        <field name="all_branches"/>
                        <field name="multi_branch" string="Multi Branch" />
                        <field name="branch_id" options="{'no_create': True}" context="{'user_preference': 0}"/>
                    </group>
                </div>
                <xpath expr="//page[@name='access_rights']" position="after">
                    <page
                       
                        name="system_branches" string="Branches">
                        <group>
                            <field name="max_discount"/>
                            <field name="branch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        
                    </page>
                </xpath>
            </field>
        </record>
        <record id="view_users_branch_pref_form" model="ir.ui.view">
            <field name="name">res.users.branch.preferences.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <field name="all_branches" invisible="1"/>
                    <field name="multi_branch" invisible="1"/>
                    <field
                        name="branch_id" options="{'no_create': True, 'no_open': True}"  context="{'user_preference': 1}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
