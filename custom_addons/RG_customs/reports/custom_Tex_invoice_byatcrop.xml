             <!-- Add Google Fonts Link in the <head> -->

            <style>
                .invoice-header, .client-info, .invoice-details, .total-section, .payment-terms {
                    width: 100%;
                    margin-bottom: 20px;
                  /*  font-family: "Segoe UI", Arial, sans-serif;  */
                }
                .div-info {
                     display: flex; align-items: center;
                }
                .company-info {
                    width: 100%;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;

                }
                .company-logo img {
                    max-height: 150px;
                    width: 150px;
                    height : 100px;
                    padding-left: 80px;

                }
                .company-contact {
                    padding-right: 300px;
                    text-align: right;
                    font-size: 12px;
                }
                .company-contact p {
                    margin: 0;
                    line-height: 1.4;
                }
                .company-contact i {
                    margin-right: 5px;
                    color: #333;
                }
                .client-info p, .invoice-details p {
                    margin: 0;
                    font-size: 12px;
                }

                .invoice-header{
                 background-color: #F5F5F5;
                }
                .invoice-details {
                    background-color: #F5F5F5;
                    padding: 10px;
                }

                .header-details {
                    background-color: #FFFFFF;
                    padding: 10px;
                }

                .invoice-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 12px;
                }
                .invoice-table th, .invoice-table td {

                    padding: 8px;
                    text-align: right;
                }
                .invoice-table th {
                    background-color: #FFFFFF;
                    color: #000000;
                }
                .invoice-table td {
                    color: #333;
                }
                .total-section p, .payment-terms p {
                    margin: 5px 0;
                    font-size: 12px;
                    text-align: right;
                }
                .grand-total {
                    font-size: 16px;
                    font-weight: bold;
                }
                .payment-terms {
                    border-top: 1px solid #ddd;
                    padding-top: 10px;
                    font-size: 12px;
                }
                .hr {
                    padding: 5px;
                    border-bottom: 2px solid #000;
                }

                .invoice-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 20px;
  /* font-family: "Segoe UI", Arial, sans-serif; */
}

.to-client {
    font-size: 12px;
    line-height: 1.6;
    width: 40%;
}

.to-client h1 {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
}

.to-client p {
    margin: 0;
}

.invoice-info {
    width: 55%;
    text-align: right;
    font-size: 12px;
}

.invoice-date table {
    width: 100%;
                 font-size: 15px;
    border-collapse: collapse;
     text-align: right; /* Align text to the right */
}
                .section-date  {
    padding: 5px;
    border-bottom: 2px solid #000000; /* Black underline for invoice details */
                width: 5px;

}

                .horizontal-line {
    border-bottom: 2px solid #FFA500; /* 2px thick solid black line */
    width: 60%; /* Full width of the container */
    margin: 20px 0; /* Adds space above and below the line */
            float: right;
}
                   .horizontal-line_header_table {
    border: 1px solid black; /* 2px thick solid black line */
    width: 100%; /* Full width of the container */
    margin: 20px 0; /* Adds space above and below the line */
            float: right;

}


.invoice-date strong {
    font-size: 50px;
    color: black;
 /*  font-family: "Segoe UI"; */
}
                .tax_invoiceLable {
                font-size: 15px;
               /* font-family: "Segoe UI"; */
}
                .invoice-date p{
                 /*font-family: 'Segoe UI', Segoe UI, Geneva, Verdana, sans-serif;*/
                font-size: 15px;
                font-weight: bold;
                color: #FFA500;


}

                .th-border-black {
                 border: 1px solid black; /* Black border */
                 background-color: #000;
                 color: white;              /* White text */
                 text-align: center;        /* Centered text */
                padding: 8px;
                width: 50%; /* Left column takes 50% */
                 text-align: left;
}
                  .th-border-gray {
                 background-color: #f2f2f2;
                width: 50%; /* Left column takes 50% */
                 text-align: left;

}
                .left-column {
                 width: 50%; /* Left column takes 50% */
                 text-align: left;
}

                 .right-column {
                 width: 50%; /* Right column takes 50% */
                    text-align: right;
}
             .vl {
                   border-left: 6px solid #ffca33; height: 120px; margin-right: 10px;
}

                .container {
    display: flex;
    justify-content: space-between; /* Pushes left and right divs apart */
    align-items: center; /* Vertically centers text (optional) */
    width: 100%; /* Full width of the container */
}

.left-text {
    text-align: left; /* Aligns text to the left */
}

.right-text {
    text-align: right; /* Aligns text to the right */
}




