    margin-right: 10px;"></div> <!-- Vertical line -->
                      </div>
                <div class="col-12">
     <div style="color: #333; font-family: 'Segoe UI', sans-serif;font-size: 13px;">
        <p style="margin: 0; padding: 0;"><strong t-esc="doc.company_id.name" /></p>
        <p style="margin: 0; padding: 0;"><i class="fa fa-phone"></i> <span t-esc="doc.company_id.phone" /></p>
        <p style="margin: 0; padding: 0;"><i class="fa fa-envelope"></i> <span t-esc="doc.company_id.email" /></p>
        <p style="margin: 0; padding: 0;"><i class="fa fa-globe"></i> <span t-esc="doc.company_id.website" /></p>
        <div style="height: 1px; background-color: black; border: none; margin: 10px 0;" />
        <p style="margin: 0; padding: 0;"><i class="fa fa-map-marker"></i> <span t-esc="doc.company_id.street" />, <span t-esc="doc.company_id.city" />, <span t-esc="doc.company_id.country_id.name" /></p>
    </div>
                </div>
                                  </div>
