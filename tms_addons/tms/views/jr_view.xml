            <field name="model">tms.jr.user.branch.payment</field>
            <field name="inherit_id" ref="view_tms_jr_branch_receipt"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='branch_to_id']" position="replace">
                        <field name="user_id" options="{'no_create': true, 'no_open': true}"/>
                    </xpath>
                    <group class="nomrh">
                        <group><field name="type" widget="radio" options="{'horizontal': true}"/></group>
                        <group><field name="journal_id" widget="selection"/></group>
                    </group>
                </data>
            </field>
        </record>
        
