<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quotation_purchase_order_template">
     <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">

         <!--- script -->
               <!-- Styling Section -->
            <style>

                .invoice-header, .client-info, .invoice-details, .total-section, .payment-terms {
                    width: 100%;
                    margin-bottom: 20px;
                     font-family: 'Segoe UI', sans-serif;
                }
                .div-info {
                     display: flex; align-items: center;
                }
                .company-info {
                    width: 100%;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;

                }
                .company-logo img {
                    max-height: 60px;
                    width: 50px;
                    height : 50px;
                    padding-left: 80px;

                }
                .company-contact {
                    padding-right: 300px;
                    text-align: right;
                    font-size: 12px;
                }
                .company-contact p {
                    margin: 0;
                    line-height: 1.4;
                }
                .company-contact i {
                    margin-right: 5px;
                    color: #333;
                }
                .client-info p, .invoice-details p {
                    margin: 0;
                    font-size: 15px;
                    font-family: 'Segoe UI', sans-serif;
                }
                .invoice-details {
                    background-color: #FFFFFF;
                    padding: 10px;
                font-family: 'Segoe UI', sans-serif;
                }
                .invoice-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 12px;
                }
                .invoice-table th, .invoice-table td {

                    padding: 8px;
                    text-align: center;
                }
                .invoice-table th {
                    background-color: #FFFFFF;
                    color: #000000;
                    font-size: 16px;
                   font-family: 'Segoe UI', sans-serif;
                }
                .invoice-table td {
                    color: #333;
                   font-size: 16px;
                   font-family: 'Segoe UI', sans-serif;
                }
                .total-section p, .payment-terms p {
                    margin: 5px 0;
                    font-size: 12px;
                    text-align: right;
                }
                .grand-total {
                    font-size: 16px;
                    font-weight: bold;
                }
                .payment-terms {
                    border-top: 1px solid #ddd;
                    padding-top: 10px;
                    font-size: 12px;
                }
                .hr {
                    padding: 5px;
                    border-bottom: 2px solid #000;
                }

                .invoice-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 20px;
                font-family: 'Segoe UI', sans-serif;}

.to-client {
    font-size: 12px;
    line-height: 1.6;
    width: 40%;
}

.to-client h1 {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
}

.to-client p {
    margin: 0;
}

.invoice-info {
    width: 55%;
    text-align: right;
    font-size: 12px;
}

.invoice-date table {
    width: 100%;
    border-collapse: collapse;
}
                .section-date  {
    padding: 5px;
    border-bottom: 2px solid #000; /* Black underline for invoice details */
                text-align: right;
}

.invoice-date  {
    padding: 5px;
    border-bottom: 2px solid #000; /* Black underline for invoice details */
    font-family: 'Segoe UI', sans-serif;
}

.invoice-date strong {
    font-size: 15px;
    color: black;
                font-family: 'Segoe UI', sans-serif;
}
                .th-border-black {
                 border: 1px solid black; /* Black border */
                 background-color: #000;
                 color: white;              /* White text */
                 text-align: center;        /* Centered text */
                padding: 8px;
                width: 50%; /* Left column takes 50% */

                 font-family: 'Segoe UI', sans-serif;
                font-size: 15px;
}
                  .th-border-gray {
                 background-color: #f2f2f2;
                width: 50%; /* Left column takes 50% */
                 text-align: left;

}
                .left-column {
                 width: 50%; /* Left column takes 50% */
                 text-align: left;
}

                 .right-column {
                 width: 50%; /* Right column takes 50% */
                    text-align: right;
}
            .contact-container {
    display: flex;
    align-items: flex-start;
    font-family: Arial, sans-serif;
    font-size: 14px;
}

.vl {
    border-left: 6px solid #d8a73d; /* Gold color */
    height: 90px;
    margin-right: 10px;
}

.contact-info {
    color: #333; font-family: 'Segoe UI', sans-serif;
}

.contact-info p {
    margin: 0;
    display: flex;
    align-items: center;
    line-height: 1.6; font-family: 'Segoe UI', sans-serif;
                font-size: 15px;
}

.contact-info i {
    margin-right: 8px;

}


.separator {
    border: none;
    border-top: 1px solid black;
    margin: 10px 0;
}







            </style>

            <div class="header">
        <div class="row">

                     <div class="row mt32 mb32">
                         <div class="col-5">
                           <div style=" width: 100%;
                                  margin-bottom: 10px;
                     font-family: 'Segoe UI', sans-serif;font-size: 13px;">
                        <!-- Company Logo -->
                                <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)"  alt="Company Logo"/>

                     </div>

                         </div>
                         <div class="col-7">
                             <div class="contact-container">
                                  <div class="row mt32 mb32">
                                      <div class="col-1">
